# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Every VITE_* variable is inlined into the PUBLIC client bundle at build time. None of these
# are secrets; each is protected by its own server-side restriction, noted below.

# ── Price Tracker (Supabase) ─────────────────────────────────────────────────────
# supabase.com -> project -> Project Settings -> API. Use the anon/public key ONLY — RLS
# limits the anon role to SELECT. Never put the service_role key here.
VITE_SUPABASE_URL="https://xxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# ── Google Sheets (Billing + Dispatch) ───────────────────────────────────────────
# One key for every Sheets-backed dashboard (Sales, Billing, Dispatch) — key `imeco-hub-sheets`
# in Google Cloud project "Dashboard" (amwoodo.com). Restricted to: Google Sheets API only +
# websites http://localhost:5173/* and the hub's Vercel domain. The dev server is pinned to 5173
# for this reason (Google rejects a wildcard port).
VITE_GOOGLE_API_KEY=""

# Billing sheet. Must be shared "Anyone with the link -> Viewer".
VITE_BILLING_SPREADSHEET_ID=""
# Tab name; leave blank to use the first tab.
VITE_BILLING_SHEET_NAME=""

# Dispatch "Outbound Tracker" workbook. Must be shared "Anyone with the link -> Viewer".
VITE_DISPATCH_SPREADSHEET_ID=""

# ── Sales Mission Control ────────────────────────────────────────────────────────
# DSR workbook (monthly tabs, FY targets) plus the three ad-spend trackers.
# Each must be shared "Anyone with the link -> Viewer".
VITE_SALES_SPREADSHEET_ID=""
VITE_SALES_AD_SPEND_SPREADSHEET_ID=""
VITE_SALES_D2C_AD_SPEND_SPREADSHEET_ID=""
VITE_SALES_MEESHO_AD_SPEND_SPREADSHEET_ID=""

# ── Warehouse Stock (Dankuni + Chennai) ──────────────────────────────────────────
# Optional Google Apps Script Web App URL (see scripts/stock-apps-script.gs) that reads
# the private Dankuni & Chennai stock workbooks under your Google account. When left blank,
# the dashboard renders from src/dashboards/stock/data/stockSnapshot.json.
VITE_STOCK_APPS_SCRIPT_URL=""
